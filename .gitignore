# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Herramientas locales de pruebas y catálogos
/tool/node_modules/
/.firebase/
*service-account*.json

/tool/ffmpeg/

# Evidencias locales: pueden contener identificadores, sesiones o datos del demo.
/audit-*.json
/audit-*.patch
.env
.env.*
!.env.example
*.jks
*.keystore
**/key.properties
**/*serviceAccount*.json

# Configuraciones locales del entorno alojado (plantillas públicas en deploy/).
/deploy/*.local.json
/deploy/*.local.env
/android/app/src/production/google-services.json
/android/app/src/development/google-services.json

# Exportaciones temporales que puede generar el hub de emuladores.
/firebase-export-*/

# Reportes generados por Gradle; nunca código del producto.
/android/build/

# Material de firma, respaldos y artefactos generados.
*.p12
*.pfx
*.7z
*.dpapi
*.apk
*.aab
/tool/emulator-cache/
**/.gradle/
**/local.properties
