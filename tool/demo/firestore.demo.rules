rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Proyección booleana exclusiva del servidor, actualizada atómicamente con
    // accountAccess. Reutiliza users para respetar las 10 lecturas de Rules.
    // No se confía en users.role ni claims de rol.
    function eligible(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.datingAllowed == true;
    }
    function dating() { return request.auth != null && eligible(request.auth.uid); }
    function selfEditable(uid) {
      return !exists(/databases/$(database)/documents/accountAccess/$(uid))
        || get(/databases/$(database)/documents/accountAccess/$(uid)).data.suspended == false;
    }
    match /accountAccess/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /verificationRequests/{id} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid
        && request.query.limit != null && request.query.limit <= 20;
      allow write: if false;
    }
    function validGender(value) { return value in ['masculino', 'femenino']; }
    // Debe coincidir con DiscoveryLimits.maxAge y PreferredGender en Dart.
    function validPreferences(data) {
      return data.keys().hasAll(['minAge', 'maxAge', 'preferredGender', 'updatedAt'])
        && data.keys().hasOnly(['minAge', 'maxAge', 'preferredGender', 'updatedAt', 'careerIds'])
        && data.minAge is int && data.maxAge is int
        && data.minAge >= 18 && data.minAge <= data.maxAge && data.maxAge <= 100
        && data.preferredGender in ['masculino', 'femenino', 'ambos']
        && validCareerIds(data.get('careerIds', []));
    }
    function validCareerIds(ids) {
      return ids is list && ids.size() <= 5 && ids.toSet().size() == ids.size();
    }
    function activeCareerIds(ids) {
      return (ids.size() < 1 || careerActive(ids[0])) && (ids.size() < 2 || careerActive(ids[1]))
        && (ids.size() < 3 || careerActive(ids[2])) && (ids.size() < 4 || careerActive(ids[3]))
        && (ids.size() < 5 || careerActive(ids[4]));
    }
    function age(date) {
      return request.time.year() - date.year() -
        ((request.time.month() < date.month() ||
          (request.time.month() == date.month() && request.time.day() < date.day())) ? 1 : 0);
    }
    function accepts(preferences, profile) {
      let profileAge = age(profile.birthDate);
      return validPreferences(preferences) && validGender(profile.gender)
        && (preferences.get('careerIds', []).size() == 0 || profile.careerId in preferences.careerIds)
        && (preferences.preferredGender == 'ambos' || preferences.preferredGender == profile.gender)
        && profileAge >= preferences.minAge && profileAge <= preferences.maxAge;
    }
    function reciprocal(from, to) {
      let a = get(/databases/$(database)/documents/users/$(from)).data;
      let b = get(/databases/$(database)/documents/users/$(to)).data;
      let pa = get(/databases/$(database)/documents/preferences/$(from)).data;
      let pb = get(/databases/$(database)/documents/preferences/$(to)).data;
      return from != to && eligible(to) && a.isActive == true && b.isActive == true
        && complete(a) && complete(b) && accepts(pa, b) && accepts(pb, a);
    }
    function validUid(uid) { return uid is string && uid.matches('[A-Za-z0-9_-]{1,128}'); }
    function swipeIdFor(from, to) { return from + '.' + to; }
    function matchIdFor(a, b) { return a < b ? swipeIdFor(a, b) : swipeIdFor(b, a); }
    function noBlocks(a, b) {
      return !exists(/databases/$(database)/documents/blocks/$(swipeIdFor(a,b)))
        && !exists(/databases/$(database)/documents/blocks/$(swipeIdFor(b,a)));
    }
    function noBlocksAfter(a, b) {
      return !existsAfter(/databases/$(database)/documents/blocks/$(swipeIdFor(a,b)))
        && !existsAfter(/databases/$(database)/documents/blocks/$(swipeIdFor(b,a)));
    }
    function matchClosedAfterBlock(a, b) {
      let path = /databases/$(database)/documents/matches/$(matchIdFor(a,b));
      return !existsAfter(path) || getAfter(path).data.isActive == false;
    }
    function mutualLikeAfter(a, b) {
      let ab = getAfter(/databases/$(database)/documents/swipes/$(swipeIdFor(a,b))).data;
      let ba = getAfter(/databases/$(database)/documents/swipes/$(swipeIdFor(b,a))).data;
      return ab.fromUserId == a && ab.toUserId == b && ab.type == 'like'
        && ba.fromUserId == b && ba.toUserId == a && ba.type == 'like';
    }
    function matchingRequired(data) {
      let reverse = /databases/$(database)/documents/swipes/$(swipeIdFor(data.toUserId,data.fromUserId));
      return data.type != 'like' || !exists(reverse) || get(reverse).data.type != 'like'
        || getAfter(/databases/$(database)/documents/matches/$(matchIdFor(data.fromUserId,data.toUserId))).data.users
          == (data.fromUserId < data.toUserId ? [data.fromUserId,data.toUserId] : [data.toUserId,data.fromUserId]);
    }
    function matched(a, b) {
      let path = /databases/$(database)/documents/matches/$(matchIdFor(a,b));
      return exists(path) && get(path).data.isActive == true
        && a in get(path).data.users && b in get(path).data.users;
    }
    function matchedCard(viewer, uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return viewer != uid && matched(viewer, uid) && eligible(uid) && user.isActive == true
        && complete(user) && resource.data == cardFields(user);
    }
    function cardFields(user) {
      // Solo edad cumplida. Comparar también en lectura cierra el acceso a
      // fichas antiguas con birthDate o a edades vencidas tras un cumpleaños.
      return {'firstName': user.firstName, 'age': user.birthDate is timestamp ? age(user.birthDate) : null, 'gender': user.gender,
        'description': user.description, 'careerId': user.careerId, 'mainPhotoUrl': user.mainPhotoUrl,
        'interestIds': user.interestIds, 'isActive': user.isActive, 'updatedAt': user.updatedAt};
    }
    function adult(date) {
      return date is timestamp &&
        (request.time.year() - date.year() > 18 ||
          (request.time.year() - date.year() == 18 &&
            (request.time.month() > date.month() ||
              (request.time.month() == date.month() && request.time.day() >= date.day()))));
    }
    function careerActive(id) {
      return id is string && get(/databases/$(database)/documents/careers/$(id)).data.isActive == true;
    }
    function interestActive(id) {
      return id is string && get(/databases/$(database)/documents/interests/$(id)).data.isActive == true;
    }
    function validInterests(ids) {
      return (ids.size() < 1 || interestActive(ids[0]))
        && (ids.size() < 2 || interestActive(ids[1]))
        && (ids.size() < 3 || interestActive(ids[2]))
        && (ids.size() < 4 || interestActive(ids[3]))
        && (ids.size() < 5 || interestActive(ids[4]));
    }
    function ownPhoto(url, uid) {
      return url is string && url.matches('profile_photos/' + uid + '/[A-Za-z0-9_-]{1,128}')
        && url in get(/databases/$(database)/documents/profilePhotoManifests/$(uid)).data.paths;
    }
    function validPhotos(urls, uid) {
      return urls is list && urls.size() <= 6 && urls.toSet().size() == urls.size()
        && (urls.size() < 1 || ownPhoto(urls[0], uid))
        && (urls.size() < 2 || ownPhoto(urls[1], uid))
        && (urls.size() < 3 || ownPhoto(urls[2], uid))
        && (urls.size() < 4 || ownPhoto(urls[3], uid))
        && (urls.size() < 5 || ownPhoto(urls[4], uid))
        && (urls.size() < 6 || ownPhoto(urls[5], uid));
    }
    function complete(data) {
      return data.firstName.matches('.*\\S.*') && data.lastName.matches('.*\\S.*')
        && adult(data.birthDate) && validGender(data.gender)
        && careerActive(data.careerId) && data.photoUrls.size() > 0
        && data.mainPhotoUrl is string && data.mainPhotoUrl in data.photoUrls;
    }
    function schema(data, uid) {
      return data.keys().hasAll(['firstName', 'lastName', 'email', 'birthDate', 'gender', 'description', 'careerId', 'photoUrls', 'mainPhotoUrl', 'interestIds', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['firstName', 'lastName', 'email', 'birthDate', 'gender', 'description', 'careerId', 'photoUrls', 'mainPhotoUrl', 'interestIds', 'role', 'isActive', 'createdAt', 'updatedAt', 'datingAllowed'])
        && data.get('datingAllowed', false) is bool
        && data.firstName is string && data.firstName.size() <= 80
        && data.lastName is string && data.lastName.size() <= 80
        && data.gender is string && data.gender.size() <= 50
        && data.description is string && data.description.size() <= 500
        && (data.birthDate == null || adult(data.birthDate))
        && (data.careerId == null || (data.careerId is string && data.careerId.size() > 0 && data.careerId.size() <= 128))
        && data.interestIds is list && data.interestIds.size() <= 5
        && data.interestIds.toSet().size() == data.interestIds.size()
        && validPhotos(data.photoUrls, uid)
        && ((data.photoUrls.size() == 0 && data.mainPhotoUrl == null)
          || (data.photoUrls.size() > 0 && data.mainPhotoUrl is string && data.mainPhotoUrl in data.photoUrls))
        && data.isActive is bool && (!data.isActive || complete(data))
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && schema(request.resource.data, uid)
        && !request.resource.data.keys().hasAny(['datingAllowed'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.isActive == false
        && adult(request.resource.data.birthDate)
        && request.resource.data.firstName == '' && request.resource.data.lastName == ''
        && request.resource.data.gender == '' && request.resource.data.description == ''
        && request.resource.data.careerId == null && request.resource.data.interestIds == []
        && request.resource.data.photoUrls == [] && request.resource.data.mainPhotoUrl == null
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && selfEditable(uid) && schema(request.resource.data, uid)
        // Un género nuevo debe ser válido. Un valor legado o vacío solo
        // puede conservarse sin cambios en un perfil inactivo (p. ej. fotos).
        && (validGender(request.resource.data.gender)
          || (request.resource.data.gender == resource.data.gender
            && request.resource.data.isActive == false))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'birthDate', 'gender', 'description', 'careerId',
          'photoUrls', 'mainPhotoUrl', 'interestIds', 'isActive', 'updatedAt'])
        && (request.resource.data.careerId == resource.data.careerId
          || request.resource.data.careerId == null || careerActive(request.resource.data.careerId))
        && (request.resource.data.interestIds == resource.data.interestIds || validInterests(request.resource.data.interestIds));
      allow list, delete: if false;
    }
    match /careers/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /interests/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /preferences/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validPreferences(request.resource.data)
        && activeCareerIds(request.resource.data.get('careerIds', []))
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
    // Índice sin datos personales: solo estado y fecha de sincronización.
    match /discoveryIndex/{uid} {
      allow get: if dating() && (owner(uid) || resource.data.isActive == true);
      allow list: if dating() && resource.data.isActive == true
        && request.query.limit != null && request.query.limit <= 25;
      allow create, update: if owner(uid) && validUid(uid)
        && request.resource.data == {
          'isActive': getAfter(/databases/$(database)/documents/users/$(uid)).data.isActive,
          'updatedAt': getAfter(/databases/$(database)/documents/users/$(uid)).data.updatedAt};
      allow delete: if false;
    }
    match /discoveryCards/{uid} {
      allow get: if dating() && (owner(uid) || (validUid(request.auth.uid) && validUid(uid)
        && noBlocks(request.auth.uid, uid)
        && (matchedCard(request.auth.uid, uid) || (reciprocal(request.auth.uid, uid)
        && resource.data == cardFields(get(/databases/$(database)/documents/users/$(uid)).data)
        && !exists(/databases/$(database)/documents/swipes/$(swipeIdFor(request.auth.uid, uid))))
          )));
      allow list: if false;
      allow create, update: if owner(uid) && validUid(uid)
        && request.resource.data == cardFields(getAfter(/databases/$(database)/documents/users/$(uid)).data);
      allow delete: if false;
    }
    // Galería pública solo para una pareja activa, nunca correo o datos privados.
    match /matchProfiles/{uid} {
      function fields(user) { return {'firstName':user.firstName,'age':user.birthDate is timestamp ? age(user.birthDate) : null,'gender':user.gender,
           'description':user.description,'careerId':user.careerId,'mainPhotoUrl':user.mainPhotoUrl,
           'interestIds':user.interestIds,'isActive':user.isActive,'updatedAt':user.updatedAt,
           'photoUrls':user.photoUrls}; }
      allow get: if dating() && eligible(uid) && validUid(uid) && validUid(request.auth.uid)
        && (owner(uid) || (matched(request.auth.uid, uid) && noBlocks(request.auth.uid, uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.isActive == true
          && complete(get(/databases/$(database)/documents/users/$(uid)).data)))
        && resource.data == fields(get(/databases/$(database)/documents/users/$(uid)).data);
      allow create, update: if owner(uid)
        && request.resource.data == fields(getAfter(/databases/$(database)/documents/users/$(uid)).data);
      allow list, delete: if false;
    }
    match /swipes/{swipeId} {
      // Se puede comprobar la inexistencia del ID propio en una transacción.
      allow get: if dating() && validUid(request.auth.uid)
        && (swipeId.matches(request.auth.uid + '[.][A-Za-z0-9_-]{1,128}')
          || swipeId.matches('[A-Za-z0-9_-]{1,128}[.]' + request.auth.uid));
      allow list: if dating() && resource.data.fromUserId == request.auth.uid;
      allow create: if dating()
        && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'type', 'createdAt'])
        && request.resource.data.keys().hasOnly(['fromUserId', 'toUserId', 'type', 'createdAt'])
        && request.resource.data.fromUserId == request.auth.uid
        && validUid(request.resource.data.fromUserId) && validUid(request.resource.data.toUserId)
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && swipeId == swipeIdFor(request.resource.data.fromUserId, request.resource.data.toUserId)
        && request.resource.data.type in ['like', 'pass']
        && request.resource.data.createdAt == request.time
        && noBlocksAfter(request.auth.uid, request.resource.data.toUserId)
        && reciprocal(request.auth.uid, request.resource.data.toUserId)
        && matchingRequired(request.resource.data);
      allow update, delete: if false;
    }
    match /matches/{matchId} {
      // El ID de una pareja permite leer su inexistencia dentro de la transacción.
      allow get: if dating() && validUid(request.auth.uid)
        && ((exists(/databases/$(database)/documents/matches/$(matchId)) && request.auth.uid in resource.data.users)
          || (!exists(/databases/$(database)/documents/matches/$(matchId))
            && (matchId.matches(request.auth.uid + '[.][A-Za-z0-9_-]{1,128}')
              || matchId.matches('[A-Za-z0-9_-]{1,128}[.]' + request.auth.uid))));
      allow list: if dating() && request.auth.uid in resource.data.users;
      allow create: if dating()
        && request.resource.data.keys().hasAll(['users','createdAt','isActive'])
        && request.resource.data.keys().hasOnly(['users','createdAt','isActive'])
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && validUid(request.resource.data.users[0]) && validUid(request.resource.data.users[1])
        && request.resource.data.users[0] < request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && eligible(request.resource.data.users[0]) && eligible(request.resource.data.users[1])
        && matchId == matchIdFor(request.resource.data.users[0],request.resource.data.users[1])
        && request.resource.data.isActive == true && request.resource.data.createdAt == request.time
        && noBlocksAfter(request.resource.data.users[0], request.resource.data.users[1])
        && mutualLikeAfter(request.resource.data.users[0],request.resource.data.users[1]);
      allow update: if dating() && request.auth.uid in resource.data.users
        && resource.data.isActive == true && request.resource.data.isActive == false
        && request.resource.data.keys().hasAll(['users','createdAt','isActive','closedAt','closedBy'])
        && request.resource.data.keys().hasOnly(['users','createdAt','isActive','closedAt','closedBy'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive','closedAt','closedBy'])
        && !resource.data.keys().hasAny(['closedAt','closedBy'])
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.closedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        // Mantener sincronizados con ChatLimits en Dart.
        function maxMessageLength() { return 1000; }
        function maxChatHistory() { return 50; }
        function trimmedText(text) {
          // RE2 trim() no cubre todos los espacios Unicode que Dart elimina.
          let edge = '[\\s\\x{0085}\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]';
          return !text.matches(edge + '[\\s\\S]*|[\\s\\S]*' + edge);
        }
        function participant() {
          let path = /databases/$(database)/documents/matches/$(matchId);
          let pair = get(path).data;
          return dating() && exists(path)
            && pair.users is list && pair.users.size() == 2
            && validUid(pair.users[0]) && validUid(pair.users[1])
            && pair.users[0] < pair.users[1]
            && matchId == matchIdFor(pair.users[0],pair.users[1])
            && pair.isActive is bool && pair.createdAt is timestamp
            && eligible(pair.users[0]) && eligible(pair.users[1])
            && request.auth.uid in pair.users;
        }
        function verifiedUpload() {
          let a = get(/databases/$(database)/documents/chatUploads/$(matchId + '.' + messageId)).data;
          return a.state == 'ready' && a.expiresAt > request.time
            && a.uid == request.auth.uid && a.matchId == matchId
            && a.path == request.resource.data.mediaPath
            && a.type == request.resource.data.type
            && (!request.resource.data.keys().hasAny(['durationMs'])
              || (a.durationMs is int && a.durationMs > 0 && a.durationMs <= 61500
                && request.resource.data.durationMs >= a.durationMs - 1500
                && request.resource.data.durationMs <= a.durationMs + 1500));
        }
        // El historial de texto se conserva al desactivar el match.
        allow get: if participant();
        allow list: if participant()
          && request.query.limit != null && request.query.limit <= maxChatHistory();
        allow create: if participant()
          && noBlocksAfter(get(/databases/$(database)/documents/matches/$(matchId)).data.users[0],
            get(/databases/$(database)/documents/matches/$(matchId)).data.users[1])
          && get(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true
          && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true
          && request.resource.data.keys().hasAll(['senderId','text','createdAt'])
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt','type','mediaPath','durationMs'])
          && (!request.resource.data.keys().hasAny(['durationMs'])
            || (request.resource.data.get('type','text') == 'audio'
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs > 0 && request.resource.data.durationMs <= 60000))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && ((request.resource.data.get('type', 'text') == 'text'
            && !request.resource.data.keys().hasAny(['mediaPath'])
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= maxMessageLength()
            && trimmedText(request.resource.data.text))
            || (request.resource.data.get('type', 'text') in ['image', 'audio']
              && verifiedUpload()
              && request.resource.data.text == ''
              && request.resource.data.mediaPath == 'chat_media/' + matchId + '/' + request.auth.uid + '/' + messageId))
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time;
        allow update: if participant()
          && get(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true
          && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true
          && noBlocksAfter(get(/databases/$(database)/documents/matches/$(matchId)).data.users[0],
            get(/databases/$(database)/documents/matches/$(matchId)).data.users[1])
          && resource.data.senderId != request.auth.uid
          && !resource.data.keys().hasAny(['readAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }
    match /blocks/{blockId} {
      // Solo GET de los IDs propios, incluyendo inexistencia transaccional.
      // El destinatario y terceros no pueden consultar este documento.
      allow get: if request.auth != null && validUid(request.auth.uid)
        && blockId.matches(request.auth.uid + '[.][A-Za-z0-9_-]{1,128}');
      allow list, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['blockerId','blockedId','createdAt'])
        && request.resource.data.keys().hasOnly(['blockerId','blockedId','createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && validUid(request.resource.data.blockerId) && validUid(request.resource.data.blockedId)
        && request.resource.data.blockerId != request.resource.data.blockedId
        && blockId == swipeIdFor(request.resource.data.blockerId,request.resource.data.blockedId)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.blockedId))
        && matchClosedAfterBlock(request.auth.uid, request.resource.data.blockedId);
    }
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['reporterId','reportedId','reason','details','createdAt','status'])
        && request.resource.data.keys().hasOnly(['reporterId','reportedId','reason','details','createdAt','status'])
        && request.resource.data.reporterId == request.auth.uid
        && validUid(request.resource.data.reporterId) && validUid(request.resource.data.reportedId)
        && request.resource.data.reporterId != request.resource.data.reportedId
        && reportId == swipeIdFor(request.resource.data.reporterId,request.resource.data.reportedId)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedId))
        && request.resource.data.reason in ['fake_profile','inappropriate_content','harassment','spam','other']
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';
    }
  }
}
